# Personal wallpapers (not redistributed)
/assets/wallpapers/static/*
/assets/wallpapers/live/*

# Keep directory structure
!/assets/wallpapers/static/.gitkeep
!/assets/wallpapers/live/.gitkeep

# Nix build result symlinks
/result
/result-*

# Local secrets and credentials
*.age
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example

# Editor and temporary files
*.swp
*.swo
*~
*.bak
*.orig

# Local review archives
*.zip
